# ── Sentinel sandbox (fill after portal login) ───────────────────────────────
SENTINEL_HOST=                       # host serving the camera grid
SENTINEL_INGEST_URL=                 # e.g. http://<host>/api/ingest
SENTINEL_PORTAL_COOKIE=              # session cookie if the grid requires auth
CATALOGUE_SYNC_INTERVAL_MIN=0        # scheduled re-sync, minutes; 0 = off (on-demand only)

# ── Datastores ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://saakshi:saakshi@localhost:5432/saakshi
DATABASE_POOL_MAX=50               # connections per API instance; keep total < Postgres max_connections
VALKEY_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=saakshi
MINIO_SECRET_KEY=saakshi-dev-secret
MINIO_BUCKET=saakshi-evidence
MINIO_REGION=us-east-1               # MinIO ignores it but signs with it — both sides must agree

# ── Analytics worker (workers/analytics) ─────────────────────────────────────
SAAKSHI_DEVICE=                      # cuda | mps | cpu; empty = auto-detect
SAAKSHI_YOLO_WEIGHTS=models/yolo11n.pt   # gitignored; fetched, never committed
SENTINEL_STREAM_TEMPLATE=            # overrides the URL shape entirely, e.g. https://h/{external_id}/index.m3u8

# ── ANPR (workers/analytics/anpr, D2-01) ─────────────────────────────────────
# Empty = the measured default. `paddle_ppocr` (PP-OCR weights on ONNX Runtime) measured better than
# `fast_plate_ocr` on this estate's plates — see docs/anpr-accuracy.md. `--ocr-backend` beats this.
SAAKSHI_OCR_BACKEND=                 # fast_plate_ocr | paddle_ppocr
SAAKSHI_FAST_PLATE_OCR_MODEL=        # empty = cct-s-v2-global-model
SAAKSHI_PLATE_CONF_MIN=              # empty = 0.25, the plate model's own default
SAAKSHI_PLATE_MIN_WIDTH_PX=          # empty = 20; below this an OCR string is an invention
SAAKSHI_OCR_CONF_MIN=                # empty = 0.30; votes below this are counted, not written

# ── Self-hosted services ─────────────────────────────────────────────────────
OSRM_URL=http://localhost:5000       # road graph; build it with ./scripts/import-osm.sh
OSRM_TIMEOUT_MS=2000                 # per-query ceiling; a trace is interactive
# macOS binds :5000 to the AirPlay Receiver, so the compose port is overridable. Set both when you
# move it — OSRM_HOST_PORT publishes the container, OSRM_URL is what the API dials.
# OSRM_HOST_PORT=5050
MEDIAMTX_HOST=localhost
PMTILES_PATH=./data/gujarat.pmtiles

# ── Video wall (D3-07) ───────────────────────────────────────────────────────
# WHEP is served by OUR edge gateway, never by the government sandbox — the sandbox is HLS-only
# (D1-03), so the `whep` adapter's honest status is `demonstrated`, not `operational`.
MEDIAMTX_WHEP_BASE=http://localhost:8889
MEDIAMTX_HLS_BASE=http://localhost:8888
# The synthetic 640x360 / 25 fps source with a burnt-in timer that ops/mediamtx/mediamtx.yml
# publishes on startup. It is how WHEP-vs-HLS latency is measured rather than asserted.
MEDIAMTX_SELFTEST_PATH=saakshi-test
# The relay's ceilings. A VOD playlist and its segments are immutable by the HLS spec, so caching
# them is correct — and it is what makes nine tiles cost the department gateway one copy of the
# stream instead of nine, which is the pacing the organisers explicitly ask clients for.
STREAM_RELAY_CACHE_MB=256
STREAM_RELAY_CONCURRENCY=4
STREAM_RELAY_READ_AHEAD=3
# Ceiling on one upstream request. Without one, a gateway that stops answering holds a concurrency
# slot forever and the relay wedges — observed live on 2026-09-05.
STREAM_RELAY_TIMEOUT_S=180

# ── Optional: NL query compiler (degrades to deterministic filter UI) ────────
# D3-09. With `ollama` or `none` the system is fully functional and fully open source —
# nothing proprietary is load-bearing. See docs/nl-query.md.
QUERY_COMPILER=none                  # none | openai | anthropic | ollama
# openai (primary) — strict Structured Outputs guarantees schema-valid JSON
OPENAI_API_KEY=
# gpt-4.1-mini is NOT in the current model list (checked 2026-09-05); gpt-5.6-luna is the
# current small/fast tier that supports Structured Outputs. Latency beats reasoning depth here.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=                     # optional override, e.g. a compatible gateway
# anthropic (alternate) — proves the provider swap
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5      # current, verified 2026-09-05
ANTHROPIC_BASE_URL=                  # optional override
# ollama (local fallback) — no proprietary dependency, no external network call
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ── App ──────────────────────────────────────────────────────────────────────
API_PORT=4000
JWT_SECRET=change-me
