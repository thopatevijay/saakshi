# ── Sentinel sandbox (fill after portal login) ───────────────────────────────
SENTINEL_HOST=                       # host serving the camera grid
SENTINEL_INGEST_URL=                 # e.g. http://<host>/api/ingest
SENTINEL_PORTAL_COOKIE=              # session cookie if the grid requires auth

# ── Datastores ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://saakshi:saakshi@localhost:5432/saakshi
VALKEY_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=saakshi
MINIO_SECRET_KEY=saakshi-dev-secret
MINIO_BUCKET=saakshi-evidence

# ── Self-hosted services ─────────────────────────────────────────────────────
OSRM_URL=http://localhost:5000
MEDIAMTX_HOST=localhost
PMTILES_PATH=./data/gujarat.pmtiles

# ── Optional: NL query compiler (degrades to deterministic filter UI) ────────
ANTHROPIC_API_KEY=
QUERY_COMPILER=none                  # none | anthropic | ollama
ANTHROPIC_MODEL=claude-sonnet-5

# ── App ──────────────────────────────────────────────────────────────────────
API_PORT=4000
JWT_SECRET=change-me
