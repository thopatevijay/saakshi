{
  "name": "@saakshi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db": "tsx src/db/migrate.ts",
    "bench:api": "tsx src/bench/api.ts",
    "test": "vitest run --root ../..",
    "adapter:probe": "tsx src/adapters/probe-cli.ts",
    "sync:catalogue": "tsx src/jobs/catalogue-sync-cli.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@saakshi/shared": "*",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^9.9.0",
    "postgres": "^3.4.9",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.6"
  }
}
