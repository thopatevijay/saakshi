{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/api/Dockerfile",
    "watchPatterns": ["packages/api/**", "packages/shared/**", "db/**", "config/**", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "sh -c 'API_PORT=${PORT:-4000} node packages/api/dist/index.js'",
    "preDeployCommand": "node packages/api/dist/db/migrate.js migrate",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "numReplicas": 1,
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
