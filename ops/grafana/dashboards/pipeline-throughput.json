    {
      "id": 41,
      "type": "stat",
      "title": "Throttle factor (measured / effective)",
      "description": "How many times more content the streams carry than we receive. ~1 on local MediaMTX; ~10 through the government gateway.",
      "datasource": {
        "type": "prometheus",
        "uid": "saakshi-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "saakshi-prometheus"
          },
          "editorMode": "code",
          "expr": "avg(saakshi_worker_camera_measured_fps / clamp_min(saakshi_worker_camera_effective_fps, 0.01))",
          "legendFormat": "throttle",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "O"
        }
      ]
    },
    {
      "id": 43,
      "type": "stat",
      "title": "Upstream-bound share of wall time",
      "description": "A slow gateway looks exactly like a broken worker, and one latency number cannot tell them apart. This is the fraction of wall time our threads spent blocked inside decode() \u2014 the gateway's time, not ours. Measured at 92% over a 22-minute soak on the sandbox, with ZERO reconnects. Above ~70% there is nothing to fix in this pipeline.",
      "datasource": {
        "type": "prometheus",
        "uid": "saakshi-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 70
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "saakshi-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(saakshi_worker_camera_upstream_wait_seconds_total[5m])) / clamp_min(sum(rate(saakshi_worker_camera_upstream_wait_seconds_total[5m])) + sum(rate(saakshi_worker_camera_loop_self_seconds_total[5m])), 0.001) * 100",
          "legendFormat": "upstream",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "Q"
        }
      ]
    },
