{
  "name": "saakshi",
  "private": true,
  "version": "0.1.0",
  "description": "SAAKSHI — AI-powered CCTV integration and video analytics (Gujarat Police Innovation Challenge 2026)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build --workspace @saakshi/shared",
    "dev": "npm run dev --workspace @saakshi/api & npm run dev --workspace @saakshi/web",
    "pretest": "npm run build --workspace @saakshi/shared",
    "build": "npm run build --workspace @saakshi/shared && npm run build --workspace @saakshi/api && npm run build --workspace @saakshi/web",
    "typecheck": "npm run build --workspace @saakshi/shared && npm run typecheck --workspace @saakshi/api && npm run typecheck --workspace @saakshi/web",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:migrate": "npm run db --workspace @saakshi/api -- migrate",
    "db:rollback": "npm run db --workspace @saakshi/api -- rollback",
    "db:reset": "npm run db --workspace @saakshi/api -- reset",
    "db:status": "npm run db --workspace @saakshi/api -- status",
    "bench:api": "npm run bench:api --workspace @saakshi/api",
    "bench:plate-search": "npm run bench:plate-search --workspace @saakshi/api",
    "adapter:probe": "npm run adapter:probe --workspace @saakshi/api --",
    "sync:catalogue": "npm run sync:catalogue --workspace @saakshi/api --",
    "trust:recompute": "npm run trust:recompute --workspace @saakshi/api --",
    "consume:sightings": "npm run consume:sightings --workspace @saakshi/api --",
    "consume:evidence": "npm run consume:evidence --workspace @saakshi/api --",
    "evidence:retention": "npm run evidence:retention --workspace @saakshi/api --",
    "evidence:sign": "npm run evidence:sign --workspace @saakshi/api --",
    "seed:watchlist": "npm run seed:watchlist --workspace @saakshi/api --"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.15.3",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "lighthouse": "^12.8.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
