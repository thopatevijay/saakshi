node_modules/
.next/
# `next build` output. Deliberately separate from `.next` so a build cannot delete the chunks a
# running `next dev` is serving — see packages/web/src/lib/dist-dir.ts (D3-13).
.next-prod/
dist/
build/
*.tsbuildinfo
# Generated by `next dev`/`next build`, regenerated on every run.
next-env.d.ts
.env
.env.local
*.log
__pycache__/
*.pyc
.venv/
venv/
data/
evidence/*
!evidence/.gitkeep
recon-out/
*.pmtiles
*.osm.pbf
.DS_Store
models/
*.pt
*.onnx
.dev-refs.md
.prp/
.claude/settings.local.json
.claude/worktrees/

# Export bundles are evidence packages built on demand — reproducible from the database and
# never a source of truth. `exports/.gitkeep` keeps the directory itself.
exports/*
!exports/.gitkeep

# D3-11's demonstration master. Retained locally and uploaded to YouTube, never committed: it is
# ~6 MB per take, it is regenerated by `packages/web/scripts/record-demo.mjs`, and the submission
# artefact is the upload, not the file.
docs/recordings/d3-11-own-feed-master.mp4
docs/recordings/*.marks.json

# Local process pids and logs from scripts/start.sh
.run/

# Demo video media (D4-03). The script and the recording tooling ARE committed — they document how
# the video was made and three defects found making it. The rendered media is not: final-demo.mp4 is
# 12.3 MB, the voiceover 3 MB, and the video lives at https://youtu.be/OrMQH0TKe3Q (unlisted), so
# git is the wrong place for it.
demo-video/clips/
demo-video/audio/
demo-video/*.mp3
demo-video/*.mp4
